/* ============ RECOMPUTE EVERYTHING ============ */
let multiSort={k:'n',dir:-1}, multiData=[], multiQ='';
function recompute(){
  const recs=filteredRecords();
  const um=userMap(recs);
  const users=[...um.values()];
  const uniq=users.length;
  const multi=users.filter(u=>u.apps.size>1);
  const totalEvents=recs.reduce((s,r)=>s+r.events,0);
  const totalTraffic=recs.reduce((s,r)=>s+r.total,0);
  // app popularity (unique users per app)
  const appU={};recs.forEach(r=>{(appU[r.app]=appU[r.app]||new Set()).add(r.user.toLowerCase());});
  const appRank=Object.entries(appU).map(([k,s])=>[k,s.size]).sort((a,b)=>b[1]-a[1]);
  // BU / OG adoption
  const buU={},ogU={};
  recs.forEach(r=>{(buU[r.bu]=buU[r.bu]||new Set()).add(r.user.toLowerCase());(ogU[r.og]=ogU[r.og]||new Set()).add(r.user.toLowerCase());});
  const buRank=Object.entries(buU).map(([k,s])=>[k,s.size]).sort((a,b)=>b[1]-a[1]);
  const ogRank=Object.entries(ogU).map(([k,s])=>[k,s.size]).sort((a,b)=>b[1]-a[1]);

  // risk exposure (heuristic enterprise-risk rating; per-user records exist for the 10 detailed apps)
  const riskOf={};DATA.apps.forEach(a=>riskOf[a.name]=a.risk);
  const highUsers=new Set(),highAppsU={};
  recs.forEach(r=>{if(riskOf[r.app]==='High'){highUsers.add(r.user.toLowerCase());(highAppsU[r.app]=highAppsU[r.app]||new Set()).add(r.user.toLowerCase());}});
  const highAppRank=Object.entries(highAppsU).map(([k,s])=>[k,s.size]).sort((a,b)=>b[1]-a[1]);
  const rc=DATA.stats.risk_counts||{};

  // scope text
  const f=[];if(ST.fApp.size)f.push(ST.fApp.size+' app(s)');if(ST.fBU.size)f.push(ST.fBU.size+' BU(s)');if(ST.fOG.size)f.push(ST.fOG.size+' OG(s)');
  document.getElementById('scope-txt').textContent=f.length?('Active scope: '+f.join(' · ')):'Showing all data (top-10 app detail)';

  // KPIs
  const kp=[
    ['AI apps detected',fmt(DATA.stats.app_count),'','+ '+DATA.stats.protected+' protected'],
    ['Unique users',fmt(uniq),'acc','in scope'],
    ['Multi-app users',fmt(multi.length),'warn',pct(multi.length,uniq)+' of users'],
    ['User-app instances',fmt(recs.length),'',''],
    ['Users on high-risk apps',fmt(highUsers.size),'warn',pct(highUsers.size,uniq)+' of users'],
    ['High-risk AI apps',fmt(rc.High||0),'warn','of '+fmt(DATA.apps.length)+' catalogued'],
    ['Events',fmt(totalEvents),'',''],
    ['Traffic',fmtBytes(totalTraffic),'good',''],
  ];
  document.getElementById('kpis').innerHTML=kp.map(k=>`<div class="kpi"><div class="lbl">${k[0]}</div><div class="val ${k[1+1]||''}">${k[1]} <small>${k[3]||''}</small></div></div>`).join('');

  // insights
  const ins=[];
  ins.push(`<li><b>${fmt(multi.length)}</b> of <b>${fmt(uniq)}</b> users (<b>${pct(multi.length,uniq)}</b>) are active on more than one AI app &mdash; meaningful cross-app overlap.</li>`);
  if(appRank.length)ins.push(`<li>Most widely adopted: <b>${appRank[0][0]}</b> with <b>${fmt(appRank[0][1])}</b> users${appRank[1]?`, followed by <b>${appRank[1][0]}</b> (${fmt(appRank[1][1])})`:''}.</li>`);
  const heavy=multi.filter(u=>u.apps.size>=5).length;
  if(heavy)ins.push(`<li><b>${fmt(heavy)}</b> power users rely on <b>5 or more</b> AI apps each.</li>`);
  const maxN=multi.reduce((m,u)=>Math.max(m,u.apps.size),0);
  const maxU=multi.find(u=>u.apps.size===maxN);
  if(maxU)ins.push(`<li>Highest overlap: <span class="lnk" data-jump="${encodeURIComponent(maxU.user)}">${maxU.user}</span> uses <b>${maxN}</b> different AI apps.</li>`);
  if(buRank.length)ins.push(`<li>Top business unit by AI adoption: <b>${buRank[0][0]}</b> (<b>${fmt(buRank[0][1])}</b> users).</li>`);
  if(ogRank.length)ins.push(`<li>Top operating group: <b>${ogRank[0][0]}</b> (<b>${fmt(ogRank[0][1])}</b> users).</li>`);
  ins.push(`<li><b style="color:var(--bad)">Risk exposure:</b> <b>${fmt(highUsers.size)}</b> users (<b>${pct(highUsers.size,uniq)}</b>) are active on <b>high-risk</b> AI apps in scope${highAppRank.length?` &mdash; led by <b>${highAppRank[0][0]}</b> (${fmt(highAppRank[0][1])} users)${highAppRank[1]?`, <b>${highAppRank[1][0]}</b> (${fmt(highAppRank[1][1])})`:''}`:''}.</li>`);
  ins.push(`<li>Heuristic enterprise-risk rating across all <b>${fmt(DATA.apps.length)}</b> catalogued AI apps: <span class="pill rh">High ${fmt(rc.High||0)}</span> <span class="pill rm">Medium ${fmt(rc.Medium||0)}</span> <span class="pill rl">Low ${fmt(rc.Low||0)}</span> &mdash; indicative guide, not Defender's official catalog score.</li>`);
  document.getElementById('insights').innerHTML=ins.join('');
  document.querySelectorAll('#insights .lnk').forEach(l=>l.onclick=()=>{document.getElementById('multi-search').value=decodeURIComponent(l.dataset.jump);multiQ=decodeURIComponent(l.dataset.jump).toLowerCase();renderMulti();document.getElementById('multi-table').scrollIntoView({behavior:'smooth'});});

  // distribution bars (1..10 apps) with value + percentage
  const distMap={};users.forEach(u=>{const n=u.apps.size;distMap[n]=(distMap[n]||0)+1;});
  const dmx=Math.max(1,...Object.values(distMap));
  distRows=[['# of AI apps','Users','% of users']];
  let db='';for(let n=1;n<=10;n++){const c=distMap[n]||0;const p=uniq?(c/uniq*100):0;
    distRows.push([n,c,p.toFixed(1)+'%']);
    db+=`<div class="bar-row"><div class="nm" style="width:78px">${n} app${n>1?'s':''}</div>
    <div class="bar-track"><div class="bar-fill" style="width:${(c/dmx*100).toFixed(1)}%"></div>
      <span style="position:absolute;left:8px;top:0;line-height:20px;font-size:11px;font-weight:600;color:#fff">${p.toFixed(1)}%</span></div>
    <div class="vl" style="width:110px">${fmt(c)} <span style="color:var(--acc2)">(${p.toFixed(1)}%)</span></div></div>`;}
  document.getElementById('dist-bars').innerHTML=db
    +`<div class="mini" style="margin-top:8px">Base: ${fmt(uniq)} unique users &middot; percentages of all users in scope.</div>`;

  // multi-app table data
  multiData=multi.map(u=>({user:u.user,og:u.og,bu:u.bu,n:u.apps.size,apps:[...u.apps].sort(),events:u.events,total:u.total,recs:u.recs}));
  document.getElementById('multi-sub').textContent='('+fmt(multiData.length)+' users)';
  renderMulti();

  // top10 cards
  renderCards(appU);
  // all apps tab
  renderAllApps();
  // refresh open drill if any
  if(drillState.app){ if(!appU[drillState.app] || (ST.fApp.size && !ST.fApp.has(drillState.app))){ closeDrill(); } else renderDrill(); }
}

