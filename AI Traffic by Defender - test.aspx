      <td class="num">${fmt(e[1])}</td><td class="num">${pct(e[1],tot)}</td></tr>`).join('');
  document.querySelectorAll('#grp-table .grp-row').forEach(r=>r.onclick=()=>{const gg=decodeURIComponent(r.dataset.g);drillState.grp=drillState.grp===gg?null:gg;renderDrill();});
  let cb=`Drilling into <b>${drillState.app}</b> <span class="chip">${fmt(tot)} users</span> grouped by <b>${dk==='bu'?'BU':'OG'}</b>`;
  if(drillState.grp)cb+=` <span class="chip">${drillState.grp}</span>`;
  document.getElementById('crumb').innerHTML=cb;
  document.getElementById('clear-grp').style.display=drillState.grp?'inline-block':'none';
  renderUsers();
}
function renderUsers(){
  let recs=appRecords();
  if(drillState.grp)recs=recs.filter(r=>(r[drillState.dim]||'Unknown')===drillState.grp);
  if(drillState.q)recs=recs.filter(r=>(r.user+' '+r.og+' '+r.bu).toLowerCase().includes(drillState.q));
  recs=[...recs].sort((a,b)=>{let va=a[uSort.k],vb=b[uSort.k];
    if(typeof va==='string'){va=va.toLowerCase();vb=vb.toLowerCase();return va<vb?uSort.dir:va>vb?-uSort.dir:0;}
    return ((va||0)-(vb||0))*uSort.dir;});
  drillFiltered=recs;
  const cap=400,shown=recs.slice(0,cap);
  document.querySelector('#user-table tbody').innerHTML=shown.length?shown.map(u=>`<tr>
    <td title="${u.user}">${u.user}</td><td>${u.og}</td><td>${u.bu}</td>
    <td class="num">${fmt(u.events)}</td><td class="num">${fmtBytes(u.total)}</td></tr>`).join('')
    :`<tr><td colspan="5" class="empty">No users match.</td></tr>`;
  let txt=fmt(recs.length)+' user'+(recs.length===1?'':'s');if(recs.length>cap)txt+=` (showing first ${cap})`;
  document.getElementById('drill-count').textContent=txt;
}

