    <td class="num">${fmt(r.events)}</td><td class="num">${fmtBytes(r.total)}</td></tr>`).join('')
    :`<tr><td colspan="7" class="empty">No multi-app users match.</td></tr>`;
  tb.querySelectorAll('.muser').forEach(tr=>tr.onclick=()=>{
    const r=shown[+tr.dataset.i];
    const nx=tr.nextElementSibling;
    if(nx&&nx.classList.contains('exp')){nx.remove();return;}
    document.querySelectorAll('#multi-table .exp').forEach(e=>e.remove());
    const det=r.recs.slice().sort((a,b)=>b.total-a.total).map(x=>`<tr><td>${x.app}</td><td class="num">${fmt(x.events)}</td><td class="num">${fmt(x.blocked)}</td><td class="num">${fmtBytes(x.total)}</td></tr>`).join('');
    const exp=document.createElement('tr');exp.className='exp';
    exp.innerHTML=`<td colspan="7"><div class="sub"><b>${r.user}</b> &mdash; ${r.n} apps &middot; ${r.bu} / ${r.og}
      <table style="margin-top:8px"><thead><tr><th>AI App</th><th class="num">Events</th><th class="num">Blocked</th><th class="num">Traffic</th></tr></thead><tbody>${det}</tbody></table></div></td>`;
    tr.after(exp);
  });
  let txt=fmt(rows.length)+' multi-app user'+(rows.length===1?'':'s');if(rows.length>cap)txt+=` (showing first ${cap})`;
  document.getElementById('multi-count').textContent=txt;
}

