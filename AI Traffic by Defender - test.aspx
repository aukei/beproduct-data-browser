  multiSort.dir=multiSort.k===k?-multiSort.dir:(['user','og','bu'].includes(k)?1:-1);multiSort.k=k;renderMulti();});
function renderMulti(){
  let rows=multiData;
  if(multiQ)rows=rows.filter(r=>(r.user+' '+r.og+' '+r.bu).toLowerCase().includes(multiQ));
  rows=[...rows].sort((a,b)=>{let va=a[multiSort.k],vb=b[multiSort.k];
    if(typeof va==='string'){va=va.toLowerCase();vb=vb.toLowerCase();return va<vb?multiSort.dir:va>vb?-multiSort.dir:0;}
    return ((va||0)-(vb||0))*multiSort.dir;});
  multiFiltered=rows;
  const cap=300,shown=rows.slice(0,cap);
  const tb=document.querySelector('#multi-table tbody');
  tb.innerHTML=shown.length?shown.map((r,i)=>`<tr class="muser" data-i="${i}">
    <td title="${r.user}">${r.user}</td><td>${r.og}</td><td>${r.bu}</td>
    <td class="num"><b style="color:var(--acc2)">${r.n}</b></td>
