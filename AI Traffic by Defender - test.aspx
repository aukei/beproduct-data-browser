<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Traffic by Defender</title>
<style>
:root{
  --bg:#0b1020;--panel:#141b2f;--panel2:#1b2440;--line:#27314f;
  --txt:#e6ebf5;--mut:#93a0bd;--acc:#4f8cff;--acc2:#22d3ee;
  --good:#34d399;--warn:#fbbf24;--bad:#f87171;
  --c0:#4f8cff;--c1:#22d3ee;--c2:#a78bfa;--c3:#34d399;--c4:#fbbf24;
  --c5:#f87171;--c6:#f472b6;--c7:#60a5fa;--c8:#2dd4bf;--c9:#c084fc;
}
*{box-sizing:border-box}
body{margin:0;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--txt);font-size:14px}
header{padding:18px 28px;background:linear-gradient(120deg,#101733,#1a2547);border-bottom:1px solid var(--line)}
header h1{margin:0;font-size:22px;font-weight:600;letter-spacing:.3px}
header .sub{color:var(--mut);font-size:13px;margin-top:4px}
.tabs{display:flex;gap:4px;padding:0 28px;background:var(--panel);border-bottom:1px solid var(--line)}
.tab{padding:13px 20px;cursor:pointer;color:var(--mut);font-weight:600;border-bottom:2px solid transparent;user-select:none}
.tab:hover{color:var(--txt)}.tab.active{color:var(--acc);border-bottom-color:var(--acc)}
/* filter bar */
.filterbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:14px 28px;background:var(--panel2);border-bottom:1px solid var(--line)}
.filterbar .fl{color:var(--mut);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.ms{position:relative}
.ms-btn{background:var(--panel);border:1px solid var(--line);color:var(--txt);padding:8px 14px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;min-width:150px;text-align:left;display:flex;justify-content:space-between;gap:10px;align-items:center}
.ms-btn:hover{border-color:var(--acc)}
.ms-btn .cnt{background:var(--acc);color:#fff;border-radius:12px;padding:1px 8px;font-size:11px}
.ms-pop{position:absolute;z-index:50;top:42px;left:0;width:280px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.5);padding:10px;display:none}
.ms-pop.open{display:block}
.ms-pop input.s{width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--txt);padding:7px 10px;border-radius:7px;font-size:13px;margin-bottom:8px}
.ms-actions{display:flex;gap:8px;margin-bottom:8px}
.ms-actions button{flex:1;background:var(--panel2);border:1px solid var(--line);color:var(--mut);padding:6px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600}
.ms-actions button:hover{color:var(--txt);border-color:var(--acc)}
.ms-list{max-height:240px;overflow:auto}
.ms-item{display:flex;align-items:center;gap:9px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:13px}
.ms-item:hover{background:var(--panel2)}
.ms-item input{accent-color:var(--acc);width:15px;height:15px}
.ms-item .c{margin-left:auto;color:var(--mut);font-size:11px}
.btn{background:var(--panel);border:1px solid var(--line);color:var(--txt);padding:8px 14px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600}
.btn:hover{border-color:var(--acc)}
.btn.warn{color:var(--warn)}
.btn.xport{color:var(--good);border-color:rgba(52,211,153,.4)}
.btn.xport:hover{border-color:var(--good);background:rgba(52,211,153,.08)}
.wrap{padding:22px 28px;max-width:1340px;margin:0 auto}
.view{display:none}.view.active{display:block}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:14px;margin-bottom:22px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 17px}
.kpi .lbl{color:var(--mut);font-size:11px;text-transform:uppercase;letter-spacing:.5px}
.kpi .val{font-size:25px;font-weight:700;margin-top:6px}
.kpi .val small{font-size:12px;color:var(--mut);font-weight:500}
.kpi .val.acc{color:var(--acc2)}.kpi .val.good{color:var(--good)}.kpi .val.warn{color:var(--warn)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin-bottom:20px}
.card h2{margin:0 0 14px;font-size:16px;font-weight:600}
.card h2 small{color:var(--mut);font-weight:400;font-size:12px;margin-left:8px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid2b{display:grid;grid-template-columns:1.3fr 1fr;gap:20px}
@media(max-width:900px){.grid2,.grid2b{grid-template-columns:1fr}}
ul.ins{list-style:none;padding:0;margin:0}
ul.ins li{padding:11px 14px;background:var(--panel2);border-left:3px solid var(--acc);border-radius:8px;margin-bottom:10px;line-height:1.5}
ul.ins li b{color:var(--acc2)}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);font-size:13px}
th{color:var(--mut);font-weight:600;text-transform:uppercase;font-size:11px;letter-spacing:.4px;cursor:pointer;user-select:none}
th:hover{color:var(--txt)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
tbody tr:hover{background:var(--panel2)}
.bar-row{display:flex;align-items:center;gap:10px;margin:7px 0}
.bar-row .nm{width:150px;flex-shrink:0;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-track{flex:1;background:var(--panel2);border-radius:6px;height:20px;position:relative;overflow:hidden}
.bar-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--acc),var(--acc2))}
.bar-row .vl{width:64px;text-align:right;font-variant-numeric:tabular-nums;color:var(--mut);font-size:12px}
.pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:600}
.pill.prot{background:rgba(52,211,153,.15);color:var(--good)}
.pill.disc{background:rgba(96,165,250,.15);color:var(--c7)}
.pill.rh{background:rgba(248,113,113,.16);color:var(--bad)}
.pill.rm{background:rgba(251,191,36,.16);color:var(--warn)}
.pill.rl{background:rgba(52,211,153,.15);color:var(--good)}
.tag{display:inline-block;background:var(--panel);border:1px solid var(--line);padding:1px 8px;border-radius:14px;font-size:11px;margin:2px 3px 0 0;color:var(--acc2)}
.app-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.app-card{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:14px 16px;cursor:pointer;transition:.15s;position:relative}
.app-card:hover{border-color:var(--acc);transform:translateY(-2px)}
.app-card.sel{border-color:var(--acc);box-shadow:0 0 0 1px var(--acc)}
.app-card .rk{position:absolute;top:10px;right:12px;font-size:11px;color:var(--mut);font-weight:700}
.app-card .an{font-weight:600;font-size:14px;margin-bottom:10px;padding-right:24px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.app-card .au{font-size:24px;font-weight:700;color:var(--acc2)}
.app-card .au small{font-size:12px;color:var(--mut);font-weight:500}
.app-card .desc{font-size:11px;color:var(--mut);margin-top:8px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.app-card .meta{font-size:11px;color:var(--mut);margin-top:6px}
td.desc-cell{color:var(--mut);font-size:12px;max-width:320px;line-height:1.4}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:16px}
.seg{display:inline-flex;background:var(--panel2);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg button{background:none;border:none;color:var(--mut);padding:8px 16px;cursor:pointer;font-weight:600;font-size:13px}
.seg button.active{background:var(--acc);color:#fff}
input.search{background:var(--panel2);border:1px solid var(--line);color:var(--txt);padding:8px 12px;border-radius:8px;font-size:13px;min-width:220px}
input.search::placeholder{color:var(--mut)}
.grp-row{cursor:pointer}.grp-row.sel td{background:rgba(79,140,255,.12)}
.crumb{color:var(--mut);font-size:13px;margin-bottom:12px}
.crumb b{color:var(--txt)}
.crumb .chip{display:inline-block;background:var(--panel2);border:1px solid var(--line);padding:3px 10px;border-radius:16px;margin-left:6px;color:var(--acc2);font-weight:600}
.empty{color:var(--mut);padding:28px;text-align:center}
.mini{font-size:11px;color:var(--mut)}
.scroll{max-height:520px;overflow:auto}
.scroll::-webkit-scrollbar,.ms-list::-webkit-scrollbar{width:9px;height:9px}
.scroll::-webkit-scrollbar-thumb,.ms-list::-webkit-scrollbar-thumb{background:var(--line);border-radius:6px}
.hint{color:var(--mut);font-size:12px;margin-bottom:14px}
.exp td{background:var(--panel2)}
.exp .sub{padding:8px 12px}
.lnk{color:var(--acc2);cursor:pointer;font-weight:600}
.scope{font-size:12px;color:var(--mut);margin-left:auto}
.legend{display:flex;flex-wrap:wrap;gap:10px 16px;margin-top:14px}
.legend .it{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--mut)}
.legend .sw{width:12px;height:12px;border-radius:3px;flex-shrink:0}
select.sel{background:var(--panel2);border:1px solid var(--line);color:var(--txt);padding:7px 10px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer}
select.sel:hover{border-color:var(--acc)}
.pie-wrap{display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:center}
table.mx th,table.mx td{white-space:nowrap}
table.mx th.rot{font-size:10px;letter-spacing:0;text-transform:none;font-weight:600;vertical-align:bottom}
table.mx td.loc{font-weight:600;color:var(--txt);position:sticky;left:0;background:var(--panel);z-index:2}
table.mx th.loc{position:sticky;left:0;background:var(--panel);z-index:3}
table.mx td.mxc{text-align:center;font-variant-numeric:tabular-nums;color:var(--txt);font-size:12px;border:1px solid var(--bg)}
table.mx td.z{color:var(--mut);opacity:.45}
</style>
</head>
<body>
<header>
  <h1>AI Traffic by Defender</h1>
  <div class="sub">Microsoft Defender for Cloud Apps &mdash; AI usage analysis &middot; snapshot 2026-06-01</div>
</header>
<div class="tabs">
  <div class="tab active" data-v="exec">Executive Summary</div>
  <div class="tab" data-v="top10">Top 10 AI Apps</div>
  <div class="tab" data-v="allapps">All AI Apps</div>
  <div class="tab" data-v="loc">AI usage by location</div>
</div>

<div class="filterbar">
  <span class="fl">Filters</span>
  <div class="ms" id="ms-bu"></div>
  <div class="ms" id="ms-og"></div>
  <div class="ms" id="ms-app"></div>
  <button class="btn warn" id="clear-all">Clear all</button>
  <span class="scope" id="scope-txt"></span>
</div>

<div class="wrap">
  <!-- EXEC SUMMARY -->
  <div class="view active" id="v-exec">
    <div class="kpis" id="kpis"></div>
    <div class="grid2b">
      <div class="card">
        <h2>Key Insights</h2>
        <ul class="ins" id="insights"></ul>
      </div>
      <div class="card">
        <h2>Users by number of AI apps <small>cross-app overlap</small>
          <button class="btn xport" id="exp-dist" style="float:right;padding:5px 10px;font-size:12px">Export CSV</button></h2>
        <div id="dist-bars"></div>
      </div>
    </div>
    <div class="card">
      <h2>Top 30 AI Apps by Users <small>column I &middot; "Users" &middot; share of all user instances</small>
        <button class="btn xport" id="exp-top30" style="float:right;padding:5px 10px;font-size:12px">Export CSV</button></h2>
      <div class="scroll" style="max-height:660px"><div id="top30-bars"></div></div>
    </div>
    <div class="card">
      <h2>Users with multiple AI apps <small id="multi-sub"></small></h2>
      <div class="hint">Users active on 2&plus; of the top-10 AI apps. Click a row to drill down their per-app usage.</div>
      <div class="toolbar">
        <input class="search" id="multi-search" placeholder="Search user, OG or BU...">
        <button class="btn xport" id="exp-multi">Export CSV</button>
        <span class="mini" id="multi-count"></span>
      </div>
      <div class="scroll">
        <table id="multi-table">
          <thead><tr>
            <th data-k="user">User</th><th data-k="og">OG</th><th data-k="bu">BU</th>
            <th class="num" data-k="n"># Apps</th><th>Apps</th>
            <th class="num" data-k="events">Events</th><th class="num" data-k="total">Traffic</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- TOP 10 -->
  <div class="view" id="v-top10">
    <div class="card">
      <h2>Top 10 AI Apps by Users <small>ranked on column I &middot; "Users"</small></h2>
      <div class="hint">Click any app to drill down its user list, then group by <b>BU</b> (ext23_Company group) or <b>OG</b> (ext21_Reporting OG). User counts reflect the active filters.</div>
      <div class="app-grid" id="app-grid"></div>
    </div>
    <div class="card" id="drill" style="display:none">
      <div class="crumb" id="crumb"></div>
      <div class="toolbar">
        <div class="seg" id="dim-seg">
          <button data-d="bu" class="active">Group by BU</button>
          <button data-d="og">Group by OG</button>
        </div>
        <input class="search" id="user-search" placeholder="Search user, OG or BU...">
        <button class="btn" id="clear-grp" style="display:none">Clear group filter</button>
        <button class="btn xport" id="exp-drill">Export CSV</button>
        <span class="mini" id="drill-count"></span>
      </div>
      <div class="grid2b">
        <div>
          <h2 style="font-size:14px" id="grp-title"></h2>
          <div class="scroll">
            <table id="grp-table">
              <thead><tr><th id="grp-h">Group</th><th class="num">Users</th><th class="num">% of app</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
        <div>
          <h2 style="font-size:14px">User list</h2>
          <div class="scroll">
            <table id="user-table">
              <thead><tr>
                <th data-k="user">User</th><th data-k="og">OG</th><th data-k="bu">BU</th>
                <th class="num" data-k="events">Events</th><th class="num" data-k="total">Traffic</th>
              </tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="empty card" id="drill-empty">Select an AI app above to view its user drill-down.</div>
  </div>

  <!-- ALL AI APPS -->
  <div class="view" id="v-allapps">
    <div class="card">
      <h2>All AI Apps <small id="alla-sub"></small></h2>
      <div class="hint">Distribution of every discovered &amp; protected AI app. Switch between a <b>bar</b> or <b>pie</b> view, choose the ranking metric, and how many apps to show. Use the <b>AI App</b> filter above to narrow the list. This view always covers all apps; <b>BU/OG</b> filters apply to the Top 10 tab only.</div>
      <div class="toolbar">
        <div class="seg" id="alla-chart-seg">
          <button data-c="bar" class="active">Bar</button>
          <button data-c="pie">Pie</button>
        </div>
        <div class="seg" id="alla-metric-seg">
          <button data-m="users" class="active">Users</button>
          <button data-m="traffic">Traffic</button>
          <button data-m="transactions">Transactions</button>
        </div>
        <select class="sel" id="alla-topn">
          <option value="10">Top 10</option>
          <option value="15">Top 15</option>
          <option value="30" selected>Top 30</option>
          <option value="50">Top 50</option>
          <option value="all">All</option>
        </select>
        <button class="btn xport" id="exp-alla">Export CSV</button>
        <span class="mini" id="alla-note"></span>
      </div>
      <div id="alla-chart"></div>
    </div>
    <div class="card">
      <h2>All AI Apps table <small id="alla-tcount"></small></h2>
      <div class="hint" id="risk-hint">The <b>Risk</b> column is a heuristic enterprise-risk rating derived from each app's governance status (sanctioned/<i>Protected</i> vs. discovered/shadow) and whether it is a consumer generative-AI or chatbot service that may retain or train on submitted data. It is an indicative guide for prioritisation, not Microsoft Defender's official Cloud App Catalog risk score.</div>
      <div class="toolbar">
        <span class="fl" style="color:var(--mut);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px">Filters</span>
        <div class="ms" id="ms-tbu"></div>
        <div class="ms" id="ms-tog"></div>
        <div class="ms" id="ms-tapp"></div>
        <div class="ms" id="ms-trisk"></div>
        <button class="btn warn" id="tbl-clear">Clear</button>
      </div>
      <div class="toolbar">
        <input class="search" id="alla-search" placeholder="Search app, description or category...">
        <button class="btn xport" id="exp-allatbl">Export CSV</button>
        <span class="mini" id="risk-legend"></span>
      </div>
      <div class="scroll" style="max-height:560px">
        <table id="alla-table">
          <thead><tr>
            <th data-k="name">Name</th><th data-k="desc">Description</th><th data-k="type">Type</th><th data-k="category">Category</th><th data-k="risk">Risk</th>
            <th class="num" data-k="users">Users</th><th class="num" data-k="transactions">Transactions</th>
            <th class="num" data-k="traffic">Traffic</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- AI USAGE BY LOCATION TAB -->
  <div class="view" id="v-loc">

    <!-- AI App by user location -->
    <div class="card">
      <h2>AI usage by user location <small>office / location from M365 directory</small></h2>
      <div class="hint">User office locations were resolved from the Microsoft&nbsp;365 / Entra directory. Location analysis covers the <b>per-user records</b> available for the top-10 detailed AI apps. The global <b>AI&nbsp;App</b> filter narrows the tables below; the <b>App&nbsp;&times;&nbsp;Location matrix</b> has its own Apps, BU and OG filters.</div>
      <ul class="ins" id="loc-insights"></ul>
    </div>

    <div class="grid2b">
      <div class="card">
        <h2>Users by location <small id="loc-sub"></small>
          <button class="btn xport" id="exp-loc" style="float:right;padding:5px 10px;font-size:12px">Export CSV</button></h2>
        <div class="toolbar">
          <input class="search" id="loc-search" placeholder="Search location...">
          <span class="mini" id="loc-count"></span>
        </div>
        <div class="scroll" style="max-height:520px">
          <table id="loc-table">
            <thead><tr>
              <th data-k="loc">Location</th>
              <th class="num" data-k="users">Users</th>
              <th class="num" data-k="apps">AI apps</th>
              <th data-k="top">Top 5 AI apps</th>
              <th class="num" data-k="traffic">Traffic</th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
      <div class="card">
        <h2>Top locations by AI users</h2>
        <div id="loc-bars"></div>
      </div>
    </div>

    <div class="card">
      <h2 id="locmx-title">AI App &times; Location matrix <small>unique users per app per location</small>
        <button class="btn xport" id="exp-locmx" style="float:right;padding:5px 10px;font-size:12px">Export CSV</button></h2>
      <div class="toolbar">
        <span class="fl" style="color:var(--mut);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px">Apps</span>
        <div class="ms" id="ms-locmx"></div>
        <span class="fl" style="color:var(--mut);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px">BU</span>
        <div class="ms" id="ms-mxbu"></div>
        <span class="fl" style="color:var(--mut);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px">OG</span>
        <div class="ms" id="ms-mxog"></div>
        <button class="btn warn" id="mx-clear">Clear</button>
        <div class="seg" id="locmx-view-seg">
          <button data-v="loc" class="active">Location &times; App</button>
          <button data-v="app">App &times; Location</button>
        </div>
      </div>
      <div class="hint" id="locmx-hint"></div>
      <div class="scroll" style="max-height:560px;overflow:auto">
        <table id="locmx-table" class="mx"><thead></thead><tbody></tbody></table>
      </div>
    </div>
  </div>
