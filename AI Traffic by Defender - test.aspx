function renderAllBar(apps,grandBase){
  const top=topNapps(apps);const mx=Math.max(1,...top.map(metricVal));
  let h='';top.forEach((a,i)=>{const v=metricVal(a),p=grandBase?v/grandBase*100:0;
    h+=`<div class="bar-row"><div class="nm" style="width:26px;color:var(--mut);flex-shrink:0">${i+1}</div>
      <div class="nm" style="width:185px" title="${a.name}">${a.name}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${(v/mx*100).toFixed(1)}%"></div>
        <span style="position:absolute;left:8px;top:0;line-height:20px;font-size:11px;font-weight:600;color:#fff">${p.toFixed(1)}%</span></div>
      <div class="vl" style="width:150px">${metricFmt(v)} <span style="color:var(--acc2)">(${p.toFixed(1)}%)</span></div></div>`;});
  document.getElementById('alla-chart').innerHTML=h||'<div class="empty">No apps in current filter.</div>';
}
function renderAllPie(apps,grandBase){
  const top=topNapps(apps);
  const slices=top.map((a,i)=>({label:a.name,val:metricVal(a),col:COL[i%COL.length]}));
  const rest=grandBase-slices.reduce((s,x)=>s+x.val,0);
  if(rest>0.5)slices.push({label:'Others ('+fmt(apps.length-top.length)+')',val:rest,col:'#475569'});
  if(!slices.length){document.getElementById('alla-chart').innerHTML='<div class="empty">No apps in current filter.</div>';return;}
  const cx=130,cy=130,R=120,r=66;let ang=-Math.PI/2,paths='';
  slices.forEach(s=>{const frac=grandBase?s.val/grandBase:0,a2=ang+frac*2*Math.PI;
    paths+=`<path d="${arcPath(cx,cy,R,r,ang,a2)}" fill="${s.col}"><title>${s.label}: ${metricFmt(s.val)} (${(frac*100).toFixed(1)}%)</title></path>`;ang=a2;});
  const svg=`<svg width="260" height="260" viewBox="0 0 260 260">${paths}
    <text x="${cx}" y="${cy-4}" text-anchor="middle" fill="#e6ebf5" font-size="15" font-weight="700">${metricFmt(grandBase)}</text>
    <text x="${cx}" y="${cy+14}" text-anchor="middle" fill="#93a0bd" font-size="11">total ${metricLabel().toLowerCase()}</text></svg>`;
  const legend='<div class="legend">'+slices.map(s=>`<div class="it"><span class="sw" style="background:${s.col}"></span>${s.label} — ${metricFmt(s.val)} (${grandBase?(s.val/grandBase*100).toFixed(1):0}%)</div>`).join('')+'</div>';
  document.getElementById('alla-chart').innerHTML=`<div class="pie-wrap">${svg}<div style="flex:1;min-width:260px">${legend}</div></div>`;
}
function tblBUOGset(){ // app names with per-user records in the selected BU/OG (null = no BU/OG filter)
  const b=ST.tBU,o=ST.tOG;
  if(b.size===0&&o.size===0)return null;
  const s=new Set();
  for(const r of DATA.records){if((b.size===0||b.has(r.bu))&&(o.size===0||o.has(r.og)))s.add(r.app);}
  return s;
}
function renderAllTable(){
  let rows=allaData.slice();
  if(ST.aQ)rows=rows.filter(a=>(a.name+' '+(a.category||'')+' '+(a.desc||'')+' '+(a.risk||'')).toLowerCase().includes(ST.aQ));
  if(ST.tApp.size)rows=rows.filter(a=>ST.tApp.has(a.name));
  if(ST.tRisk.size)rows=rows.filter(a=>ST.tRisk.has(a.risk));
  const buog=tblBUOGset();
  if(buog)rows=rows.filter(a=>buog.has(a.name));
  rows=rows.sort((a,b)=>{let va=allaSort.k==='risk'?a.riskw:a[allaSort.k],vb=allaSort.k==='risk'?b.riskw:b[allaSort.k];
    if(typeof va==='string'){va=(va||'').toLowerCase();vb=(vb||'').toLowerCase();return va<vb?allaSort.dir:va>vb?-allaSort.dir:0;}
    return ((va||0)-(vb||0))*allaSort.dir;});
  allaTblRows=[['Name','Description','Type','Category','Risk','Users','Transactions','Traffic (bytes)']];
  rows.forEach(a=>allaTblRows.push([a.name,a.desc||'',a.type,a.category||'',a.risk||'',a.users,a.transactions,a.traffic]));
  const cap=300,shown=rows.slice(0,cap);
  const rcls=r=>r==='High'?'rh':r==='Medium'?'rm':'rl';
  document.querySelector('#alla-table tbody').innerHTML=shown.length?shown.map(a=>`<tr>
    <td title="${a.name}">${a.name}</td>
    <td class="desc-cell" title="${(a.desc||'').replace(/"/g,'&quot;')}">${a.desc||'-'}</td>
    <td><span class="pill ${a.type==='Protected'?'prot':'disc'}">${a.type}</span></td>
    <td>${a.category||'-'}</td>
    <td><span class="pill ${rcls(a.risk)}">${a.risk||'-'}</span></td>
    <td class="num">${fmt(a.users)}</td><td class="num">${fmt(a.transactions)}</td><td class="num">${fmtBytes(a.traffic)}</td></tr>`).join('')
    :'<tr><td colspan="8" class="empty">No apps match.</td></tr>';
  let txt=fmt(rows.length)+' app'+(rows.length===1?'':'s');if(rows.length>cap)txt+=` (showing first ${cap})`;
  if(ST.tBU.size||ST.tOG.size)txt+=' · BU/OG narrowing uses per-user data (10 detailed apps); apps without per-user records are excluded while a BU/OG filter is active. Users / Transactions / Traffic remain whole-org totals.';
  document.getElementById('alla-tcount').textContent=txt;
}
document.querySelectorAll('#alla-chart-seg button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#alla-chart-seg button').forEach(x=>x.classList.toggle('active',x===b));ST.aChart=b.dataset.c;renderAllApps();});
document.querySelectorAll('#alla-metric-seg button').forEach(b=>b.onclick=()=>{if(b.disabled)return;document.querySelectorAll('#alla-metric-seg button').forEach(x=>x.classList.toggle('active',x===b));ST.aMetric=b.dataset.m;renderAllApps();});
document.getElementById('alla-topn').onchange=e=>{ST.aTopN=e.target.value;renderAllApps();};
document.getElementById('alla-search').oninput=e=>{ST.aQ=e.target.value.toLowerCase();renderAllTable();};
document.querySelectorAll('#alla-table th').forEach(th=>th.onclick=()=>{const k=th.dataset.k;allaSort.dir=allaSort.k===k?-allaSort.dir:(['name','desc','type','category'].includes(k)?1:-1);allaSort.k=k;renderAllTable();});

/* ---------- CSV export handlers ---------- */
function stamp(){return new Date().toISOString().slice(0,10);}
document.getElementById('exp-alla').onclick=()=>downloadCSV('AI_all_apps_'+stamp()+'.csv',allaRows);
document.getElementById('exp-allatbl').onclick=()=>downloadCSV('AI_all_apps_table_'+stamp()+'.csv',allaTblRows);
document.getElementById('exp-top30').onclick=()=>downloadCSV('AI_top30_apps_'+stamp()+'.csv',top30Rows);
document.getElementById('exp-dist').onclick=()=>downloadCSV('AI_users_by_app_count_'+stamp()+'.csv',distRows);
document.getElementById('exp-multi').onclick=()=>{
  const rows=[['User','OG','BU','Num apps','Apps','Events','Traffic (bytes)']];
  multiFiltered.forEach(r=>rows.push([r.user,r.og,r.bu,r.n,r.apps.join('; '),r.events,r.total]));
  downloadCSV('AI_multi_app_users_'+stamp()+'.csv',rows);
};
document.getElementById('exp-drill').onclick=()=>{
  if(!drillState.app){return;}
  const rows=[['User','OG','BU','App','Events','Blocked','Traffic (bytes)']];
  drillFiltered.forEach(r=>rows.push([r.user,r.og,r.bu,r.app,r.events,r.blocked,r.total]));
  const safe=drillState.app.replace(/[^a-z0-9]+/gi,'_');
  downloadCSV('AI_'+safe+'_users_'+stamp()+'.csv',rows);
};
document.getElementById('exp-loc').onclick=()=>downloadCSV('AI_by_location_'+stamp()+'.csv',locRows);
document.getElementById('exp-locmx').onclick=()=>downloadCSV('AI_app_by_location_matrix_'+stamp()+'.csv',locMxRows);

recompute();
</script>
</body>
</html>