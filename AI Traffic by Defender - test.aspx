function metricVal(a){return ST.aMetric==='traffic'?a.traffic:ST.aMetric==='transactions'?a.transactions:a.users;}
function metricLabel(){return ST.aMetric==='traffic'?'Traffic':ST.aMetric==='transactions'?'Transactions':'Users';}
