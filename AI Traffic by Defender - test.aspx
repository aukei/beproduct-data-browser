/* ---------- AI App by user location ---------- */
let locSort={k:'users',dir:-1}, locData=[], locRows=[], locMxRows=[], locQ='', locByU=[];
function locRecords(){const a=ST.fApp;return DATA.records.filter(r=>a.size===0||a.has(r.app));}
function heatCol(frac){ // frac 0..1 -> transparent to accent blue
  const t=Math.pow(frac,0.6);
  return `background:rgba(79,140,255,${(0.10+0.80*t).toFixed(3)})`;
}
function computeLoc(){
  const recs=locRecords();
  const m=new Map(); // loc -> {users:Set, apps:Set, traffic, appU:{app:Set}}
  for(const r of recs){
    const L=r.loc||'Unknown';let e=m.get(L);
    if(!e){e={loc:L,users:new Set(),apps:new Set(),traffic:0,appU:{}};m.set(L,e);}
    const uk=r.user.toLowerCase();
    e.users.add(uk);e.apps.add(r.app);e.traffic+=r.total;
    (e.appU[r.app]=e.appU[r.app]||new Set()).add(uk);
  }
  return [...m.values()].map(e=>{
    const ranked=Object.entries(e.appU).map(([ap,s])=>[ap,s.size]).sort((a,b)=>b[1]-a[1]);
    const top=ranked.length?ranked[0][0]:'-', topN=ranked.length?ranked[0][1]:0;
    const top5=ranked.slice(0,5).map(([ap,n])=>({app:ap,users:n}));
    return {loc:e.loc,users:e.users.size,apps:e.apps.size,top,topN,top5,traffic:e.traffic,appU:e.appU};
  });
}
function renderLocations(){
  locData=computeLoc();
  const totUsers=locData.reduce((s,d)=>s+d.users,0);
  const realLoc=locData.filter(d=>d.loc!=='Unknown');
  document.getElementById('loc-sub').textContent='('+fmt(locData.length)+' locations)';

  // insights
  const byU=[...locData].sort((a,b)=>b.users-a.users);
  const byUReal=byU.filter(d=>d.loc!=='Unknown');
  const ins=[];
  if(byUReal.length)ins.push(`<li>Most AI users are in <b>${byUReal[0].loc}</b> with <b>${fmt(byUReal[0].users)}</b> users${byUReal[1]?`, then <b>${byUReal[1].loc}</b> (${fmt(byUReal[1].users)})`:''}.</li>`);
  // region rollup
  const reg={};locData.forEach(d=>{if(d.loc==='Unknown')return;const rg=d.loc.split('/').slice(-1)[0].trim();(reg[rg]=reg[rg]||{u:0});reg[rg].u+=d.users;});
  const regRank=Object.entries(reg).sort((a,b)=>b[1].u-a[1].u);
  if(regRank.length)ins.push(`<li>Top region by AI adoption: <b>${regRank[0][0]}</b> (<b>${fmt(regRank[0][1].u)}</b> users) across all its offices.</li>`);
  const byApps=[...byUReal].sort((a,b)=>b.apps-a.apps);
  if(byApps.length)ins.push(`<li><b>${byApps[0].loc}</b> shows the widest AI tool spread — <b>${byApps[0].apps}</b> different apps in use.</li>`);
  const unk=locData.find(d=>d.loc==='Unknown');
  if(unk)ins.push(`<li><b>${fmt(unk.users)}</b> users (<b>${pct(unk.users,totUsers)}</b>) could not be matched to an office in the directory and are grouped as <b>Unknown</b>.</li>`);
  if(byUReal.length)ins.push(`<li>The top 5 locations account for <b>${pct(byUReal.slice(0,5).reduce((s,d)=>s+d.users,0),totUsers)}</b> of all located AI users.</li>`);
  document.getElementById('loc-insights').innerHTML=ins.join('');

  // top-location bars
  const top=byU.slice(0,12);const mx=Math.max(1,...top.map(d=>d.users));
  document.getElementById('loc-bars').innerHTML=top.map(d=>`
    <div class="bar-row"><div class="nm" style="width:160px" title="${d.loc}">${d.loc}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${(d.users/mx*100).toFixed(1)}%"></div></div>
      <div class="vl" style="width:54px">${fmt(d.users)}</div></div>`).join('')||'<div class="empty">No location data in current filter.</div>';

  renderLocTable();
  locByU=byU;
  renderLocMatrix();
}
function renderLocTable(){
  let rows=locData.slice();
  if(locQ)rows=rows.filter(d=>d.loc.toLowerCase().includes(locQ));
  rows.sort((a,b)=>{let va=a[locSort.k],vb=b[locSort.k];
    if(typeof va==='string'){va=va.toLowerCase();vb=vb.toLowerCase();return va<vb?locSort.dir:va>vb?-locSort.dir:0;}
    return ((va||0)-(vb||0))*locSort.dir;});
  const tb=document.querySelector('#loc-table tbody');
  tb.innerHTML=rows.length?rows.map(d=>`<tr>
    <td title="${d.loc}">${d.loc}</td>
    <td class="num"><b style="color:var(--acc2)">${fmt(d.users)}</b></td>
    <td class="num">${fmt(d.apps)}</td>
    <td>${d.top5.map(t=>`<span class="tag">${t.app} <span class="mini" style="color:var(--mut)">(${fmt(t.users)})</span></span>`).join('')||'-'}</td>
    <td class="num">${fmtBytes(d.traffic)}</td></tr>`).join('')
    :'<tr><td colspan="5" class="empty">No locations match.</td></tr>';
  document.getElementById('loc-count').textContent=fmt(rows.length)+' location'+(rows.length===1?'':'s');
  locRows=[['Location','Users','AI apps','Top 5 AI apps','Traffic (bytes)']];
  rows.forEach(d=>locRows.push([d.loc,d.users,d.apps,d.top5.map(t=>t.app+' ('+t.users+')').join('; '),d.traffic]));
}
function mxRecords(){
  const b=ST.mxBU,o=ST.mxOG;
  return DATA.records.filter(r=>(b.size===0||b.has(r.bu))&&(o.size===0||o.has(r.og)));
}
function computeMxLoc(){
  const m=new Map();
  for(const r of mxRecords()){
    const L=r.loc||'Unknown';let e=m.get(L);
    if(!e){e={loc:L,users:new Set(),appU:{}};m.set(L,e);}
    const uk=r.user.toLowerCase();e.users.add(uk);
    (e.appU[r.app]=e.appU[r.app]||new Set()).add(uk);
  }
  return [...m.values()].map(e=>({loc:e.loc,users:e.users.size,appU:e.appU})).sort((a,b)=>b.users-a.users);
}
function renderLocMatrix(){
  const byU=computeMxLoc();
  const all=DATA.top10;                        // the 10 detailed apps (have per-user records)
  const apps=ST.mxApps.size?all.filter(a=>ST.mxApps.has(a)):all;
  const locs=byU.filter(d=>d.loc!=='Unknown'); // all real locations, no cap (Unknown excluded)
  const thead=document.querySelector('#locmx-table thead');
  const tb=document.querySelector('#locmx-table tbody');
  const clip=s=>s.length>16?s.slice(0,15)+'…':s;
  const colspan=(ST.mxView==='app'?locs.length:apps.length)+2;
  if(!apps.length){thead.innerHTML='';tb.innerHTML=`<tr><td class="empty" colspan="3">No apps selected — pick at least one from the Apps filter.</td></tr>`;locMxRows=[['(no apps selected)']];}
  else if(ST.mxView==='app'){
    // rows = AI apps, columns = locations; heat scaled per row (per app)
    thead.innerHTML='<tr><th class="loc">AI App</th>'+locs.map(d=>`<th class="rot num" title="${d.loc}">${clip(d.loc)}</th>`).join('')+'<th class="num">Total</th></tr>';
    tb.innerHTML=apps.length&&locs.length?apps.map(ap=>{
      const vals=locs.map(d=>d.appU[ap]?d.appU[ap].size:0);
      const rmax=Math.max(1,...vals);const tot=vals.reduce((s,v)=>s+v,0);
      const cells=vals.map(v=>v>0?`<td class="mxc" style="${heatCol(v/rmax)}">${fmt(v)}</td>`:`<td class="mxc z">·</td>`).join('');
      return `<tr><td class="loc" title="${ap}">${ap}</td>${cells}<td class="mxc"><b>${fmt(tot)}</b></td></tr>`;
    }).join(''):`<tr><td class="empty" colspan="${colspan}">No location data in current filter.</td></tr>`;
    locMxRows=[['AI App',...locs.map(d=>d.loc),'Total users (shown locations)']];
    apps.forEach(ap=>locMxRows.push([ap,...locs.map(d=>d.appU[ap]?d.appU[ap].size:0),locs.reduce((s,d)=>s+(d.appU[ap]?d.appU[ap].size:0),0)]));
  } else {
    // rows = locations, columns = AI apps; heat scaled per column (per app)
    const colMax={};apps.forEach(ap=>{colMax[ap]=Math.max(1,...locs.map(d=>(d.appU[ap]?d.appU[ap].size:0)));});
    thead.innerHTML='<tr><th class="loc">Location</th>'+apps.map(ap=>`<th class="rot num" title="${ap}">${clip(ap)}</th>`).join('')+'<th class="num">Total</th></tr>';
    tb.innerHTML=locs.length?locs.map(d=>{
      let cells='';apps.forEach(ap=>{const v=d.appU[ap]?d.appU[ap].size:0;
        cells+=v>0?`<td class="mxc" style="${heatCol(v/colMax[ap])}">${fmt(v)}</td>`:`<td class="mxc z">·</td>`;});
      return `<tr><td class="loc" title="${d.loc}">${d.loc}</td>${cells}<td class="mxc"><b>${fmt(d.users)}</b></td></tr>`;
    }).join(''):`<tr><td class="empty" colspan="${colspan}">No location data in current filter.</td></tr>`;
    locMxRows=[['Location',...apps,'Total users']];
    locs.forEach(d=>locMxRows.push([d.loc,...apps.map(ap=>d.appU[ap]?d.appU[ap].size:0),d.users]));
  }
  const av=ST.mxApps.size?fmt(apps.length)+' of '+fmt(all.length):'all '+fmt(all.length);
  document.getElementById('locmx-title').firstChild.textContent=ST.mxView==='app'?'AI App rows × Location columns ':'Location rows × AI App columns ';
  document.getElementById('locmx-hint').innerHTML=ST.mxView==='app'
    ?`Each row is one of the detailed AI apps (${av} apps); columns are <b>all ${fmt(locs.length)} offices</b> (Unknown excluded), ordered by total AI users — scroll right to see them all. Cells show unique users on that app at that office; heat is scaled <b>across each app row</b> so you can see where each tool is concentrated.`
    :`<b>All ${fmt(locs.length)} offices</b> (rows, Unknown excluded) against the detailed AI apps (${av} apps, columns). Each cell is the number of unique users at that office active on that app; heat is scaled <b>per app column</b>; deeper blue means more users.`;
  if(ST.mxBU.size||ST.mxOG.size){
    const parts=[];if(ST.mxBU.size)parts.push(ST.mxBU.size+' BU');if(ST.mxOG.size)parts.push(ST.mxOG.size+' OG');
    document.getElementById('locmx-hint').innerHTML+=` <b style="color:var(--acc2)">Scoped to ${parts.join(' + ')} — user counts reflect only the selected segment.</b>`;
  }
}
