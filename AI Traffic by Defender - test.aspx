/* ---------- filtering ---------- */
function filteredRecords(){
  const a=ST.fApp,b=ST.fBU,o=ST.fOG;
  return DATA.records.filter(r=>
    (a.size===0||a.has(r.app)) && (b.size===0||b.has(r.bu)) && (o.size===0||o.has(r.og)));
}
// unique-user map from a record list
function userMap(recs){
  const m=new Map();
  for(const r of recs){const k=r.user.toLowerCase();let e=m.get(k);
    if(!e){e={user:r.user,og:r.og,bu:r.bu,apps:new Set(),events:0,total:0,recs:[]};m.set(k,e);}
    e.apps.add(r.app);e.events+=r.events;e.total+=r.total;e.recs.push(r);}
  return m;
}

