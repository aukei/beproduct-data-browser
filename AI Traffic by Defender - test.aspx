document.querySelectorAll('#loc-table th').forEach(th=>th.onclick=()=>{const k=th.dataset.k;if(!k)return;locSort.dir=locSort.k===k?-locSort.dir:(['loc','top'].includes(k)?1:-1);locSort.k=k;renderLocTable();});
